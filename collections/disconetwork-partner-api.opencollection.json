{
  "opencollection": "1.0.0",
  "info": {
    "name": "External API for Disco Integration Partners",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create an event used to record user actions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://partners.disconetwork.com/events",
            "headers": [
              {
                "name": "version",
                "value": "1.0.0"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an event used to record user actions"
        },
        {
          "info": {
            "name": "Create a batch of events used to record user actions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://partners.disconetwork.com/events/batch",
            "headers": [
              {
                "name": "version",
                "value": "1.0.0"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit between 1 and 20 events in a single request. Each event is processed independently and the response reports the per-event result so the caller can retry only the events that failed."
        }
      ]
    },
    {
      "info": {
        "name": "Recommendations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Disco Advertiser Recommendations",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://partners.disconetwork.com/recommendations",
            "headers": [
              {
                "name": "version",
                "value": "1.0.0"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Use the Disco Network advertiser recommendation engine to get the best offers for your customers in post-purchase experiences."
        }
      ]
    }
  ],
  "bundled": true
}